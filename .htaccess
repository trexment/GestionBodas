<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to sensitive files and folders
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^(\.git|\.env|composer\.(json|lock)|package\.(json|lock)) - [F,L,NC]

    # Redirect requests to public/ folder if DocumentRoot is at project root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
